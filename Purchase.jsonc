{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string",
      "title": "Listing ID"
    },
    "listing_title": {
      "type": "string",
      "title": "Listing Title"
    },
    "buyer_id": {
      "type": "string",
      "title": "Buyer ID"
    },
    "buyer_name": {
      "type": "string",
      "title": "Buyer Name"
    },
    "seller_id": {
      "type": "string",
      "title": "Seller ID"
    },
    "price": {
      "type": "number",
      "title": "Price",
      "default": 0
    },
    "price_type": {
      "type": "string",
      "title": "Price Type",
      "enum": [
        "Free",
        "Robux"
      ],
      "default": "Free"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "roblox_username": {
      "type": "string",
      "title": "Roblox Username",
      "default": ""
    },
    "contact": {
      "type": "string",
      "title": "Contact",
      "default": ""
    }
  },
  "required": [
    "listing_id",
    "buyer_id",
    "price_type"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}